{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedrelay.dev/schemas/spec-kit/execution.schema.json",
  "title": "BoundedRelay wave-ordered execution evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "mode",
    "state",
    "routingSha256",
    "routingRevision",
    "activeWave",
    "completedWaves",
    "results",
    "checkpoints",
    "preparedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "execution" },
    "runId": { "$ref": "#/$defs/id" },
    "mode": { "const": "wave-ordered" },
    "state": { "enum": ["active", "complete"] },
    "routingSha256": { "$ref": "#/$defs/sha256" },
    "routingRevision": { "$ref": "#/$defs/revision" },
    "activeWave": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "wave",
            "baselineRevision",
            "startedAt",
            "checkExecution"
          ],
          "properties": {
            "wave": { "type": "integer", "minimum": 1, "maximum": 64 },
            "baselineRevision": { "$ref": "#/$defs/revision" },
            "startedAt": { "type": "string", "format": "date-time" },
            "checkExecution": {
              "anyOf": [
                { "type": "null" },
                { "$ref": "#/$defs/checkExecution" }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "completedWaves": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 64 }
    },
    "results": {
      "type": "array",
      "description": "Canonical task results. Active-wave caller receipts are untrusted and atomically replaced by workflow-executed receipts for the sealed required profiles. Writer checks are runtime-capped at 256 receipts across the complete execution.",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/result" }
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/checkpoint" }
    },
    "preparedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "checkReceipt": {
      "type": "object",
      "required": [
        "id",
        "source",
        "profile",
        "commandLabel",
        "commandSha256",
        "cwd",
        "exitCode",
        "stdoutSha256",
        "stderrSha256",
        "testedTree",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "enum": ["host-executed", "workflow-executed"] },
        "profile": { "$ref": "#/$defs/id" },
        "commandLabel": { "type": "string", "minLength": 1, "maxLength": 512 },
        "commandSha256": { "$ref": "#/$defs/sha256" },
        "cwd": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "exitCode": { "const": 0 },
        "stdoutSha256": { "$ref": "#/$defs/sha256" },
        "stderrSha256": { "$ref": "#/$defs/sha256" },
        "testedTree": { "$ref": "#/$defs/revision" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "checkExecution": {
      "type": "object",
      "required": [
        "writerTaskId",
        "completedRevision",
        "testedTree",
        "profileFingerprint",
        "requiredChecksSha256",
        "receiptsSha256",
        "resultsSha256",
        "verifiedAt"
      ],
      "properties": {
        "writerTaskId": { "type": ["string", "null"] },
        "completedRevision": { "$ref": "#/$defs/revision" },
        "testedTree": { "$ref": "#/$defs/revision" },
        "profileFingerprint": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }]
        },
        "requiredChecksSha256": { "$ref": "#/$defs/sha256" },
        "receiptsSha256": { "$ref": "#/$defs/sha256" },
        "resultsSha256": { "$ref": "#/$defs/sha256" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": [
        "taskId",
        "provider",
        "wave",
        "status",
        "transport",
        "effect",
        "baselineRevision",
        "modelSource",
        "model",
        "reasoningEffort",
        "verification",
        "checks",
        "startedAt",
        "completedAt"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/id" },
        "provider": { "enum": ["codex", "claude-host"] },
        "wave": { "type": "integer", "minimum": 1, "maximum": 64 },
        "status": { "const": "accepted" },
        "transport": { "enum": ["boundedrelay", "claude-host"] },
        "effect": { "enum": ["analysis", "proposal-integrated", "host-write"] },
        "baselineRevision": { "$ref": "#/$defs/revision" },
        "modelSource": { "enum": ["worker-resolved", "host-selected"] },
        "model": { "type": ["string", "null"] },
        "reasoningEffort": {
          "enum": ["low", "medium", "high", "xhigh", "max", "ultra", null]
        },
        "jobId": { "type": "string", "format": "uuid" },
        "patchFile": {
          "type": "string",
          "pattern": "^patches/[A-Za-z0-9][A-Za-z0-9._-]{0,127}\\.patch$"
        },
        "patchSha256": { "$ref": "#/$defs/sha256" },
        "changedFiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        },
        "checks": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/checkReceipt" }
        },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "effect": { "const": "analysis" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["patchFile"] },
                { "required": ["patchSha256"] },
                { "required": ["changedFiles"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "effect": { "const": "proposal-integrated" } }
          },
          "then": {
            "required": ["jobId", "patchFile", "patchSha256", "changedFiles"]
          }
        },
        {
          "if": { "properties": { "effect": { "const": "host-write" } } },
          "then": { "required": ["changedFiles"] }
        }
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "wave",
        "writerTaskId",
        "baselineRevision",
        "completedRevision",
        "changedFiles",
        "diffSha256",
        "resultsSha256",
        "checksSha256",
        "checkExecution",
        "verifiedAt"
      ],
      "properties": {
        "wave": { "type": "integer", "minimum": 1, "maximum": 64 },
        "writerTaskId": { "type": ["string", "null"] },
        "baselineRevision": { "$ref": "#/$defs/revision" },
        "completedRevision": { "$ref": "#/$defs/revision" },
        "changedFiles": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "diffSha256": { "$ref": "#/$defs/sha256" },
        "resultsSha256": { "$ref": "#/$defs/sha256" },
        "checksSha256": { "$ref": "#/$defs/sha256" },
        "checkExecution": { "$ref": "#/$defs/checkExecution" },
        "verifiedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}

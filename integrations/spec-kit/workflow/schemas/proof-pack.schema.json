{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedrelay.dev/schemas/spec-kit/proof-pack.schema.json",
  "title": "BoundedRelay run proof pack",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "runId",
    "state",
    "policy",
    "routingTotals",
    "decisions",
    "evidence",
    "codexReviews",
    "delegatedJobs",
    "executionCheckpoints",
    "checkEvidence",
    "bundleFingerprint",
    "assembledAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "proof-pack" },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "state": { "const": "complete" },
    "policy": {
      "type": "object",
      "required": [
        "routingPolicyVersion",
        "fitPolicyVersion",
        "planFingerprint"
      ],
      "properties": {
        "routingPolicyVersion": { "const": "sdd-routing-v2" },
        "fitPolicyVersion": { "const": "sdd-task-fit-v1" },
        "planFingerprint": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "routingTotals": { "type": "object" },
    "decisions": {
      "type": "object",
      "required": ["plan", "implementation", "convergence"],
      "properties": {
        "plan": { "const": "approved" },
        "implementation": { "const": "approved" },
        "convergence": { "const": "approved" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["kind", "file", "sha256", "revision", "revisionSeal"],
        "properties": {
          "kind": {
            "enum": [
              "plan-review",
              "routing",
              "execution",
              "implementation-review",
              "convergence-review"
            ]
          },
          "file": { "type": "string" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "revision": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "revisionSeal": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "codexReviews": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "phase",
          "jobId",
          "sealId",
          "hostEvidenceSha256",
          "codexEvidenceSha256"
        ],
        "properties": {
          "phase": { "enum": ["plan", "implementation", "convergence"] },
          "jobId": { "type": "string", "format": "uuid" },
          "sealId": { "$ref": "#/$defs/sha256" },
          "hostEvidenceSha256": { "$ref": "#/$defs/sha256" },
          "codexEvidenceSha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "delegatedJobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["taskId", "wave", "jobId", "effect", "baselineRevision"],
        "properties": {
          "taskId": { "type": "string" },
          "wave": { "type": "integer", "minimum": 1, "maximum": 64 },
          "jobId": { "type": "string", "format": "uuid" },
          "effect": { "enum": ["analysis", "proposal-integrated"] },
          "baselineRevision": { "$ref": "#/$defs/revision" },
          "patchSha256": { "$ref": "#/$defs/sha256" },
          "changedFiles": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "executionCheckpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "wave",
          "writerTaskId",
          "baselineRevision",
          "completedRevision",
          "diffSha256",
          "resultsSha256",
          "checksSha256"
        ],
        "properties": {
          "wave": { "type": "integer", "minimum": 1, "maximum": 64 },
          "writerTaskId": { "type": ["string", "null"] },
          "baselineRevision": { "$ref": "#/$defs/revision" },
          "completedRevision": { "$ref": "#/$defs/revision" },
          "diffSha256": { "$ref": "#/$defs/sha256" },
          "resultsSha256": { "$ref": "#/$defs/sha256" },
          "checksSha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "checkEvidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["phase", "count", "sha256"],
        "properties": {
          "phase": { "enum": ["implementation", "convergence"] },
          "count": { "type": "integer", "minimum": 0, "maximum": 256 },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "bundleFingerprint": { "$ref": "#/$defs/sha256" },
    "assembledAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    }
  }
}

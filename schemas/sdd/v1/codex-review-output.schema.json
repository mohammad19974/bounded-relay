{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedrelay.dev/schemas/sdd/v1/codex-review-output.schema.json",
  "title": "BoundedRelay Codex SDD Review Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "verdict", "summary", "findings"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "verdict": {
      "enum": ["approved", "changes-requested"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "verdict": { "const": "changes-requested" } }
      },
      "then": {
        "properties": { "findings": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "verdict": { "const": "approved" } }
      },
      "then": {
        "properties": {
          "findings": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["severity"],
                "properties": {
                  "severity": { "enum": ["critical", "high"] }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "requirement",
        "summary",
        "artifactPath",
        "nextAction"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "artifactPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "nextAction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}

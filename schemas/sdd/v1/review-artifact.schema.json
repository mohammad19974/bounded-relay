{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://boundedrelay.dev/schemas/sdd/v1/review-artifact.schema.json",
  "title": "BoundedRelay validated SDD review artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "phase",
    "seal",
    "hostEvidence",
    "codexEvidence",
    "gate"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "phase": { "$ref": "#/$defs/phase" },
    "seal": { "$ref": "#/$defs/seal" },
    "hostEvidence": { "$ref": "#/$defs/hostEvidence" },
    "codexEvidence": { "$ref": "#/$defs/codexEvidence" },
    "gate": { "$ref": "#/$defs/gate" }
  },
  "$defs": {
    "phase": { "enum": ["plan", "artifacts", "implementation", "convergence"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": {
      "type": ["string", "null"],
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mode",
        "revision",
        "clean",
        "workspaceFingerprint",
        "artifacts",
        "comparison",
        "sealId"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mode": { "enum": ["strict", "draft"] },
        "revision": { "$ref": "#/$defs/revision" },
        "clean": { "type": "boolean" },
        "workspaceFingerprint": { "$ref": "#/$defs/sha256" },
        "comparison": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["baseRevision", "changedPaths", "diffSha256"],
              "properties": {
                "baseRevision": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                "changedPaths": {
                  "type": "array",
                  "maxItems": 256,
                  "uniqueItems": true,
                  "items": { "type": "string" }
                },
                "diffSha256": { "$ref": "#/$defs/sha256" }
              }
            }
          ]
        },
        "sealId": { "$ref": "#/$defs/sha256" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": { "type": "string" },
              "bytes": { "type": "integer", "minimum": 0 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    },
    "finding": {
      "$ref": "./codex-review-output.schema.json#/$defs/finding"
    },
    "evidenceBase": {
      "type": "object",
      "required": [
        "schemaVersion",
        "reviewId",
        "phase",
        "sealId",
        "verdict",
        "summary",
        "findings"
      ],
      "allOf": [
        {
          "if": { "properties": { "verdict": { "const": "approved" } } },
          "then": {
            "properties": {
              "findings": {
                "not": {
                  "contains": {
                    "type": "object",
                    "required": ["severity"],
                    "properties": {
                      "severity": { "enum": ["critical", "high"] }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "hostEvidence": {
      "allOf": [
        { "$ref": "#/$defs/evidenceBase" },
        {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "object",
              "properties": {
                "provider": { "const": "claude" },
                "lane": { "const": "claude-host" },
                "modelSource": { "const": "host-selected" },
                "attestation": { "const": "host-declared" },
                "declaredModelLabel": { "type": "string" }
              },
              "required": ["provider", "lane", "modelSource", "attestation"],
              "additionalProperties": false
            },
            "findings": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/finding" }
            }
          },
          "required": ["reviewer"]
        }
      ]
    },
    "codexEvidence": {
      "allOf": [
        { "$ref": "#/$defs/evidenceBase" },
        {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "object",
              "properties": {
                "provider": { "const": "codex" },
                "lane": { "const": "codex" },
                "modelSource": { "const": "worker-resolved" },
                "model": { "type": "string" },
                "reasoningEffort": {
                  "enum": [
                    "server-default",
                    "low",
                    "medium",
                    "high",
                    "xhigh",
                    "max",
                    "ultra"
                  ]
                }
              },
              "required": [
                "provider",
                "lane",
                "modelSource",
                "model",
                "reasoningEffort"
              ],
              "additionalProperties": false
            },
            "execution": {
              "type": "object",
              "properties": {
                "fresh": { "const": true },
                "sandbox": { "const": "read-only" },
                "approvalPolicy": { "const": "never" },
                "ephemeral": { "const": true }
              },
              "required": ["fresh", "sandbox", "approvalPolicy", "ephemeral"],
              "additionalProperties": false
            },
            "findings": {
              "type": "array",
              "maxItems": 100,
              "items": { "$ref": "#/$defs/finding" }
            }
          },
          "required": ["reviewer", "execution"]
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "status",
        "sealId",
        "reasons",
        "freshnessReasons",
        "evidenceDigests"
      ],
      "properties": {
        "passed": { "type": "boolean" },
        "status": { "enum": ["ready", "blocked", "stale"] },
        "sealId": { "type": ["string", "null"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "freshnessReasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidenceDigests": {
          "type": "object",
          "properties": {
            "host": { "type": ["string", "null"] },
            "codex": { "type": ["string", "null"] }
          },
          "required": ["host", "codex"],
          "additionalProperties": false
        }
      }
    }
  }
}

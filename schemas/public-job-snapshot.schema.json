{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public job snapshot",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": ["queued", "running", "completed", "failed", "cancelled"]
    },
    "mode": { "enum": ["analyze", "proposal"] },
    "cwd": { "type": "string" },
    "repositoryRoot": { "type": "string" },
    "writePaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "expectedRevision": {
      "type": "string",
      "pattern": "^(?:[a-fA-F0-9]{40}|[a-fA-F0-9]{64})$"
    },
    "model": { "type": "string" },
    "reasoningEffort": {
      "enum": ["low", "medium", "high", "xhigh", "max", "ultra"]
    },
    "idempotencyKey": { "type": "string" },
    "sddReview": {
      "type": "object",
      "properties": {
        "phase": {
          "enum": ["plan", "artifacts", "implementation", "convergence"]
        },
        "mode": { "enum": ["strict", "draft"] },
        "sealId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "hostEvidenceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["phase", "mode", "sealId", "hostEvidenceDigest"],
      "additionalProperties": false
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "queuePosition": { "type": "integer", "minimum": 1 },
    "progress": {
      "type": "object",
      "properties": {
        "phase": {
          "enum": ["queued", "starting", "working", "finalizing", "terminal"]
        },
        "activity": {
          "enum": [
            "queued",
            "starting",
            "preparing_workspace",
            "preparing_review_workspace",
            "codex_started",
            "reasoning",
            "planning",
            "running_command",
            "command_completed",
            "preparing_changes",
            "using_tool",
            "researching",
            "working",
            "composing_response",
            "response_ready",
            "validating_proposal",
            "validating_review",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "activityLabel": { "type": "string", "minLength": 1 },
        "eventCount": { "type": "integer", "minimum": 0 },
        "commandCount": { "type": "integer", "minimum": 0 },
        "messageCount": { "type": "integer", "minimum": 0 },
        "lastEventType": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "sinceLastUpdateMs": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "phase",
        "activity",
        "activityLabel",
        "eventCount",
        "commandCount",
        "messageCount",
        "updatedAt",
        "elapsedMs",
        "sinceLastUpdateMs"
      ],
      "additionalProperties": false
    },
    "sessionId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": { "type": "number", "minimum": 0 },
        "cachedInputTokens": { "type": "number", "minimum": 0 },
        "outputTokens": { "type": "number", "minimum": 0 },
        "reasoningOutputTokens": { "type": "number", "minimum": 0 }
      },
      "required": [
        "inputTokens",
        "cachedInputTokens",
        "outputTokens",
        "reasoningOutputTokens"
      ],
      "additionalProperties": false
    },
    "resultAvailable": { "type": "boolean" },
    "resultTruncated": { "type": "boolean" },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "revision",
    "status",
    "mode",
    "cwd",
    "repositoryRoot",
    "createdAt",
    "progress",
    "resultAvailable",
    "resultTruncated"
  ],
  "additionalProperties": false
}

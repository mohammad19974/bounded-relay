# Conservative local analyze-only profile.
# Replace the path with one specific Git project directory.

CCW_ALLOWED_ROOTS=/absolute/path/to/project
CCW_ENABLE_PROPOSALS=false
CCW_FORWARD_AUTH_ENV=false
CCW_MAX_CONCURRENT=2
CCW_MAX_QUEUED=16
CCW_MAX_HISTORY=100
CCW_DEFAULT_TIMEOUT_MS=1200000
CCW_MAX_TIMEOUT_MS=1800000

# Keep empty to reject caller model overrides and use the Codex default.
CCW_ALLOWED_MODELS=

# Add environment variable names only when the Codex runtime genuinely needs them.
CCW_FORWARD_ENV=

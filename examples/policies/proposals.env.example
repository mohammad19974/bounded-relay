# Opt-in local proposal profile.
# Read docs/security-model.md before using it.
# Replace both paths. The state directory must be outside the project root.

CCW_ALLOWED_ROOTS=/absolute/path/to/project
CCW_STATE_DIR=/absolute/private/runtime/path/boundedrelay
CCW_ENABLE_PROPOSALS=true
CCW_FORWARD_AUTH_ENV=false

# Conservative proposal limits.
CCW_MAX_CONCURRENT=1
CCW_MAX_QUEUED=8
CCW_MAX_CHANGED_FILES=20
CCW_MAX_PATCH_BYTES=500000
CCW_MAX_OUTPUT_BYTES=1000000
CCW_DEFAULT_TIMEOUT_MS=1200000
CCW_MAX_TIMEOUT_MS=1800000

# Keep empty unless the server owner has reviewed exact model identifiers.
CCW_ALLOWED_MODELS=
CCW_FORWARD_ENV=
